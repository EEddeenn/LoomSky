{
  "name": "loomsky",
  "main": "web/worker.ts",
  "compatibility_date": "2026-10-03",
  "workers_dev": false,
  // The existing custom domain is managed in the Cloudflare dashboard.
  "services": [
    { "binding": "LOGIN", "service": "login" }
  ],
  "assets": {
    "directory": "./web/out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
